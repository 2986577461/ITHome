DEEPSEEK_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key
xiaomi_api_key=your-api-key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_EMBEDDING_MODEL=mimo-v2.5
REDIS_URL=redis://localhost:6379/0
# 必须与前端登录使用的 Java 服务一致；Docker 部署时改成业务容器地址。
BUSINESS_BASE_URL=http://localhost:8080

# 最小 Agent Harness（每个 Python 进程独立限流；修改后重启）
AGENT_TOTAL_SECONDS=120
AGENT_MODEL_SECONDS=45
AGENT_TOOL_SECONDS=15
AGENT_TITLE_SECONDS=5
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=8
# 字符预算包含序列化消息等开销，不是精确 Token 计数。
AGENT_MAX_INPUT_CHARS=32000
AGENT_MAX_OUTPUT_CHARS=24000
AGENT_MODEL_OUTPUT_TOKENS=4096
AGENT_MAX_ACTIVE_RUNS=4
AGENT_STREAM_BUFFER=32