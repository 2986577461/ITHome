<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">



<mapper namespace="com.xiaoyan.mapper.StudentFileMapper">


    <delete id="deleteByObjectNames">
        DELETE FROM student_file WHERE student_file.object_name IN
        <foreach collection="objectNames" item="objectName" open="(" separator="," close=")">
            #{objectName}
        </foreach>
    </delete>

    <select id="selectByStudentIds" resultType="com.xiaoyan.pojo.StudentFile">
        SELECT id, student_id, original_name, object_name, file_url, file_size,
               file_type, create_date_time
        FROM student_file
        WHERE student_id IN
        <foreach collection="studentIds" item="studentId" open="(" separator="," close=")">
            #{studentId}
        </foreach>
    </select>

    <delete id="deleteByStudentIds">
        DELETE FROM student_file
        WHERE student_id IN
        <foreach collection="studentIds" item="studentId" open="(" separator="," close=")">
            #{studentId}
        </foreach>
    </delete>
</mapper>