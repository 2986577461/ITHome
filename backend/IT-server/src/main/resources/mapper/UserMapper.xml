<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xiaoyan.mapper.UserMapper">
    <delete id="deletebyStudentIds">
        DELETE FROM it_student WHERE student_id IN
        <foreach collection="studentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


    <select id="selectByStudentIds" resultType="com.xiaoyan.pojo.Student">
        SELECT * FROM it_student WHERE student_id IN
        <foreach collection="studentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectPositionByIds" resultType="java.lang.String">
        SELECT position FROM it_student where student_id IN
        <foreach collection="studentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
    <!-- 「今年入会的成员」花名册。
         原来是从最大学号反推年份、再按学号取两届（p-1 和 p），既不准也不好懂；
         现在直接按入会时间过滤。

         create_date_time 为 null 的老成员会被自动排除：
         在 SQL 里 NULL = 任何值的结果是 NULL（不是 true），WHERE 就不会选中它。

         写成 YEAR(x) = YEAR(NOW()) 用不上索引，但这张表就几十行，
         可读性比那点开销重要。将来真的大了再换成 [年初, 次年初) 的范围写法。 -->
    <select id="selectThisYearsStudents" resultType="com.xiaoyan.pojo.Student">
        SELECT s.student_id,
               s.name,
               s.sex,
               s.major,
               s.class_name,
               s.academy,
               s.position
        FROM it_student s
        WHERE YEAR(s.create_date_time) = YEAR(NOW())
          AND s.deleted = 0
        ORDER BY s.student_id
    </select>
</mapper>
